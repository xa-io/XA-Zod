# Zod publishes informational metadata only. Keep this allowlist last.
# All other root files and directories, including new skill-created folders,
# remain private. Do not add source or asset exceptions from other projects.
/*
!/.gitignore
!/LICENSE
!/README.md
!/THIRD-PARTY-NOTICES.txt

# Public manifest and icon for repository/feed scanners.
!/XAZod/
/XAZod/*
!/XAZod/XAZod.json
!/XAZod/images/
/XAZod/images/*
!/XAZod/images/icon.png
